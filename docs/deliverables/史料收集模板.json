    "output_schema": {
      "slot_id": "对应 slots[].id，如 B-05",
      "status": "found | not_found | ambiguous",
      "fact": "一句话事实（可直接写进游戏正文的表述）",
      "quote": "原文摘句，没有就留空字符串",
      "source": {
        "type": "book | news | archive | museum | interview",
        "work": "书名 / 文章标题 / 档案名",
        "author": "作者 / 编者 / 发布机构",
        "publisher": "出版社 / 媒体 / 馆藏机构",
        "year": 0,
        "url": "可点击链接（book 可为空）",
        "locator": "页码 / 章节 / 段落 / 版次"
      },
      "confidence": "high | medium | low",
      "note": "存疑点、版本差异、找不到的原因"
    }
  },
  "sources_policy": {
    "accept_priority": [
      "1. 官方档案、博物馆/纪念馆展陈与官网",
      "2. 中央与地方主流媒体（新华社、人民日报、光明日报、央视、地方党报）",
      "3. 学术专著与期刊（出版社、社科文献、学报）",
      "4. 当事人回忆、口述史、日记（需注明版本）"
    ],
    "reject": [
      "百科全书、维基、百度百科等聚合型条目（可作线索，不可作最终出处）",
      "自媒体、公众号、短视频文案、论坛帖子",
      "AI 生成的总结或转述",
      "影视剧情、小说、未经核实的演义"
    ],
    "rules": [
      "每条必须能定位：给 URL 或 书名+页码/章节；两者都没有则视为未找到",
      "原文摘句必须逐字，删节用「……」；不允许意译后加引号",
      "同一事实存在多种说法时，status 填 ambiguous，quote 里并列各版本",
      "找不到就填 not_found，并在 note 写清楚查了哪些来源、为什么找不到",
      "不允许编造页码、书名、作者、数字",
      "数字类事实必须同时给出出处与统计口径"
    ]
  },
